---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { SITE } from '../lib/site';

const pubs = await getCollection('publications');
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const byYear = years.map((y) => ({
  year: y,
  items: pubs.filter((p) => p.data.year === y).sort((a, b) => a.data.order - b.data.order),
}));
---

<Base title="Publications" description="Peer-reviewed publications from the Center for Biomolecular Engineering.">
  <PageHeader
    eyebrow="Publications"
    title="Peer-reviewed work"
    lede={`${pubs.length} papers carried over from the Center's previous site, grouped by year.`}
  >
    <p class="mt-5">
      <a
        href={SITE.scholar}
        rel="noopener"
        class="inline-block rounded-card border border-cwru-blue/35 px-4 py-2.5 shadow-card transition-shadow hover:shadow-lift text-[0.9rem] font-medium text-cwru-blue transition-colors hover:border-cwru-blue hover:bg-white"
        >Full list on Google Scholar &rarr;</a
      >
    </p>
  </PageHeader>

  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    {byYear.map(({ year, items }) => (
      <section class="border-b border-rule py-12 last:border-b-0">
        <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
          {/* The year sticks under the header while its own papers scroll past
              and is pushed out by the next one. Over a list spanning fifteen
              years this is the difference between usable and not. */}
          <h2 class="sticky top-[5.4rem] z-10 h-fit bg-paper py-1 font-serif text-[1.6rem] leading-none text-copper tabular lg:text-right">
            {year}
          </h2>
          <ul class="max-w-[70ch]">{items.map((pub) => <PublicationItem pub={pub} />)}</ul>
        </div>
      </section>
    ))}
  </div>
</Base>
