---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import Placeholder from '../../components/Placeholder.astro';
import { portrait } from '../../lib/portraits';

const people = await getCollection('people');
const director = people.find((p) => p.data.featured)!;
const { Content: DirectorBio } = await render(director);
const directorFace = portrait(director.data.photo);

// The only group photograph the lab has is the one the old site used, taken
// 22 September 2023. It is shown as it is, with its date in the caption,
// because a dated real photograph is worth more than an empty box. The caption
// dates it rather than naming anyone: the roster above has changed since, and
// nobody has confirmed who is in the picture.
const groupPhoto = portrait('group_photo.png');

// One grid, in the order the lab gave, with each person's title printed under
// their name. It was split into a section per position before, which turned a
// group of seven into six headings and made the lab look emptier than it is.
const rest = people
  .filter((p) => p.id !== director.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="People" description="Members of the Center for Biomolecular Engineering at Case Western Reserve University.">
  <PageHeader
    eyebrow="People"
    title="The group"
    lede="Faculty, research staff, and students of the Center for Biomolecular Engineering."
  >
    <p class="mt-4 text-[0.9rem] text-ink-mute">
      Looking for former members? See <a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href="/people/alumni">alumni and visiting scholars</a>.
    </p>
  </PageHeader>

  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <section class="border-b border-rule py-14">
      <div class="grid gap-x-12 gap-y-8 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]" data-reveal>
        {directorFace ? (
          <figure>
            <div class="overflow-hidden rounded-card border border-rule bg-warm-deep/70">
              <Image
                src={directorFace}
                alt={`Portrait of ${director.data.name}`}
                widths={[240, 480, 720]}
                sizes="(min-width: 768px) 15rem, 90vw"
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover"
                style="aspect-ratio: 4 / 5;"
              />
            </div>
          </figure>
        ) : (
          <Placeholder ratio="4 / 5" caption={director.data.photoNote ?? `Portrait of ${director.data.name}`} />
        )}
        <div>
          <p class="label text-copper">Director</p>
          <h2 class="mt-2 text-h2 text-cwru-dark">
            {director.data.name}{director.data.credentials && <span class="text-ink-mute">, {director.data.credentials}</span>}
          </h2>

          <ul class="mt-4 max-w-[58ch] space-y-1.5 text-[0.95rem] text-ink-soft">
            {director.data.titles.map((t) => <li>{t}</li>)}
          </ul>

          <div class="prose-lab mt-6"><DirectorBio /></div>

          <dl class="mt-8 grid gap-x-12 gap-y-6 sm:grid-cols-2">
            <div>
              <dt class="label text-ink-mute">Contact</dt>
              <dd class="mt-2 space-y-1 text-[0.92rem] text-ink-soft">
                <div>Office: {director.data.office}</div>
                <div>Phone: <a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`tel:+1${director.data.phone?.replace(/\D/g, '')}`}>{director.data.phone}</a></div>
                {director.data.fax && <div>Fax: {director.data.fax}</div>}
                <div><a class="break-all text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`mailto:${director.data.email}`}>{director.data.email}</a></div>
              </dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Education</dt>
              <dd class="mt-2 space-y-1 text-[0.92rem] text-ink-soft">
                {director.data.education.map((e) => <div>{e}</div>)}
              </dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Research interests</dt>
              <dd class="mt-2 text-[0.92rem] text-ink-soft">{director.data.interests.join(' · ')}</dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Links</dt>
              <dd class="mt-2 space-y-1 text-[0.92rem]">
                {director.data.links.map((l) => (
                  <div><a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={l.href} rel="noopener">{l.label}</a></div>
                ))}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="border-b border-rule py-14">
      {groupPhoto ? (
        <figure class="max-w-[62rem]" data-reveal>
          <div class="overflow-hidden rounded-card border border-rule bg-warm-deep/70">
            <Image
              src={groupPhoto}
              alt="The lab group standing together outside the Wickenden Building"
              widths={[640, 1000, 1562]}
              sizes="(min-width: 1024px) 62rem, 92vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
          <figcaption class="mt-2.5 max-w-[52ch] text-[0.74rem] leading-snug text-ink-mute">
            The group, 22 September 2023. Dated because it predates the roster
            above — who appears in it has not been confirmed.
          </figcaption>
        </figure>
      ) : (
        <Placeholder
          ratio="3 / 1"
          caption="Group photo — the previous site used one taken 09/22/23. A current photo is needed."
          class="max-w-[62rem]"
        />
      )}
    </section>

    <section class="py-14">
      <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
        <h2 class="pt-1 label text-ink-mute lg:text-right">Lab members</h2>
        <ul class="grid grid-cols-2 gap-x-7 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
          {rest.map((p) => <li><PersonCard person={p} /></li>)}
        </ul>
      </div>
    </section>
  </div>
</Base>
