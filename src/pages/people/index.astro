---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import Placeholder from '../../components/Placeholder.astro';

const people = await getCollection('people');
const director = people.find((p) => p.data.featured)!;
const { Content: DirectorBio } = await render(director);

const rest = people
  .filter((p) => p.id !== director.id)
  .sort((a, b) => a.data.groupOrder - b.data.groupOrder || a.data.order - b.data.order);

const groups: { name: string; members: typeof rest }[] = [];
for (const p of rest) {
  const last = groups.at(-1);
  if (last?.name === p.data.group) last.members.push(p);
  else groups.push({ name: p.data.group, members: [p] });
}
---

<Base title="People" description="Members of the Center for Biomolecular Engineering at Case Western Reserve University.">
  <PageHeader
    eyebrow="People"
    title="The group"
    lede="Faculty, research staff, and students of the Center for Biomolecular Engineering."
  >
    <p class="mt-4 text-[0.9rem] text-ink-mute">
      Looking for former members? See <a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href="/people/alumni">alumni and visiting scholars</a>.
    </p>
  </PageHeader>

  <div class="mx-auto max-w-[76rem] px-5 sm:px-8">
    <section class="border-b border-rule py-14">
      <div class="grid gap-x-12 gap-y-8 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]">
        <Placeholder ratio="4 / 5" caption={director.data.photoNote ?? `Portrait of ${director.data.name}`} />
        <div>
          <p class="text-[0.72rem] font-bold uppercase tracking-[0.13em] text-copper">Director</p>
          <h2 class="mt-2 text-h2 text-cwru-dark">
            {director.data.name}{director.data.credentials && <span class="text-ink-mute">, {director.data.credentials}</span>}
          </h2>

          <ul class="mt-4 max-w-[58ch] space-y-1.5 text-[0.95rem] text-ink-soft">
            {director.data.titles.map((t) => <li>{t}</li>)}
          </ul>

          <div class="prose-lab mt-6"><DirectorBio /></div>

          <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
            <div>
              <dt class="text-[0.72rem] font-bold uppercase tracking-[0.11em] text-ink-mute">Contact</dt>
              <dd class="mt-2 space-y-1 text-[0.92rem] text-ink-soft">
                <div>Office: {director.data.office}</div>
                <div>Phone: <a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`tel:+1${director.data.phone?.replace(/\D/g, '')}`}>{director.data.phone}</a></div>
                {director.data.fax && <div>Fax: {director.data.fax}</div>}
                <div><a class="break-all text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`mailto:${director.data.email}`}>{director.data.email}</a></div>
              </dd>
            </div>
            <div>
              <dt class="text-[0.72rem] font-bold uppercase tracking-[0.11em] text-ink-mute">Education</dt>
              <dd class="mt-2 space-y-1 text-[0.92rem] text-ink-soft">
                {director.data.education.map((e) => <div>{e}</div>)}
              </dd>
            </div>
            <div>
              <dt class="text-[0.72rem] font-bold uppercase tracking-[0.11em] text-ink-mute">Research interests</dt>
              <dd class="mt-2 text-[0.92rem] text-ink-soft">{director.data.interests.join(' · ')}</dd>
            </div>
            <div>
              <dt class="text-[0.72rem] font-bold uppercase tracking-[0.11em] text-ink-mute">Links</dt>
              <dd class="mt-2 space-y-1 text-[0.92rem]">
                {director.data.links.map((l) => (
                  <div><a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={l.href} rel="noopener">{l.label}</a></div>
                ))}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="border-b border-rule py-14">
      <Placeholder
        ratio="3 / 1"
        caption="Group photo — the previous site used one taken 09/22/23. A current photo is needed."
        class="max-w-[62rem]"
      />
    </section>

    {groups.map((g) => (
      <section class="border-b border-rule py-14 last:border-b-0">
        <div class="grid gap-x-10 gap-y-8 lg:grid-cols-[10rem_minmax(0,1fr)]">
          <h2 class="pt-1 text-[0.72rem] font-bold uppercase tracking-[0.13em] text-ink-mute lg:text-right">
            {g.name}
          </h2>
          <ul class="grid grid-cols-2 gap-x-7 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
            {g.members.map((p) => <li><PersonCard person={p} /></li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>
</Base>
