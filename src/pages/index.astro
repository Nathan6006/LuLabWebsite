---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import PlatformScroll from '../components/PlatformScroll.astro';
import RevealImage from '../components/RevealImage.astro';
import Nanoparticle from '../components/Nanoparticle.astro';
import NewsItem from '../components/NewsItem.astro';
import PublicationItem from '../components/PublicationItem.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE } from '../lib/site';

const research = await getCollection('research');
const thrusts = research.filter((r) => !r.data.parent).sort((a, b) => a.data.order - b.data.order);

const allNews = await getCollection('news');
const news = allNews
  .sort((a, b) => (b.data.date?.getTime() ?? b.data.year * 1e10) - (a.data.date?.getTime() ?? a.data.year * 1e10))
  .filter((n) => n.data.featured)
  .slice(0, 3);

const allPubs = await getCollection('publications');
const pubs = allPubs.sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order).slice(0, 3);
const alumni = await getCollection('alumni');

// Counted from the content collections at build time — nothing asserted by
// hand. See TODO.md on how stale the underlying source is.
const figures = [
  { value: allPubs.length, label: 'Publications' },
  { value: alumni.length, label: 'Lab alumni' },
  { value: thrusts.length + research.filter((r) => r.data.parent).length, label: 'Research programmes' },
  { value: 4, label: 'Shared instruments' },
];

// Imagery per research area. The MRI grid is on-subject — the lab builds MRI
// contrast agents — and is credited on /credits, because it is not their scan.
//
// The nucleic acid card carries the lipid nanoparticle render instead of a
// photograph: it is a picture of the thing the card is about, which no stock
// image can be.
const CARD_IMAGE: Record<string, string> = {
  '01-molecular-imaging': 'card-imaging',
};
const CARD_RENDER = '02-gene-therapy';
---

<Base description={SITE.mission}>
  <HeroScene />

  <!-- Figures rail. Counted from the content, run up on arrival. -->
  <section class="border-b border-rule bg-cwru-blue text-white">
    <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
      <dl class="grid grid-cols-2 divide-cwru-light/25 sm:grid-cols-4 sm:divide-x" data-reveal>
        {figures.map((f) => (
          <div class="border-b border-cwru-light/25 px-1 py-8 sm:border-b-0 sm:px-7 sm:first:pl-0 sm:last:pr-0" data-reveal-item>
            <dt class="label text-cwru-light">{f.label}</dt>
            <dd class="mt-2 font-serif text-[2.6rem] font-[400] leading-none tabular" data-count={f.value}>0</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Approach. The one paragraph on the site that is read a word at a time:
       it starts dim and each word takes its full colour as the paragraph
       crosses the middle of the viewport, which sets a reading pace on exactly
       the sentence that most needs reading. Used once, deliberately. -->
  <section id="approach" class="scroll-mt-24 mx-auto max-w-[78rem] px-5 py-28 sm:px-8 sm:py-36">
    <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[11rem_minmax(0,1fr)]">
      <SectionHead label="Approach" index="01" />
      <div>
        <p
          class="max-w-[30ch] font-serif text-[1.72rem] font-[420] leading-[1.3] tracking-[-0.018em] text-cwru-dark sm:text-[2.25rem]"
          data-highlight
        >
          {SITE.missionExtended}
        </p>
      </div>
    </div>
  </section>

  <!-- The signature moment: pinned, scrubbed, one point cloud morphing through
       the three structures the lab actually builds. -->
  <PlatformScroll />

  <!-- Research areas -->
  <section class="border-y border-rule bg-warm">
    <div class="mx-auto max-w-[78rem] px-5 py-20 sm:px-8 sm:py-24">
      <div class="grid gap-x-12 gap-y-10 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
        <SectionHead label="Research" index="02" />
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="text-h2 text-cwru-dark">Research areas</h2>
            <a class="group inline-flex items-center gap-1.5 text-[0.88rem] font-medium text-cwru-blue" href="/research">
              All research
              <ArrowRight className="size-3.5 transition-transform duration-200 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
            </a>
          </div>

          <ul class="mt-10 grid gap-px bg-rule sm:grid-cols-2" style="perspective: 1200px;">
            {thrusts.map((t, i) => (
              <li data-reveal-item>
                <a
                  href={`/research#${t.id}`}
                  data-tilt
                  class="tilt-card group relative flex h-full flex-col bg-paper transition-colors duration-200 hover:bg-warm"
                >
                  <span class="absolute inset-x-0 top-0 z-10 h-[2px] origin-left scale-x-0 bg-copper transition-transform duration-300 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-x-100"></span>
                  {t.id === CARD_RENDER ? (
                    <div class="relative isolate overflow-hidden bg-cwru-dark" style="aspect-ratio: 21 / 9;">
                      <div class="absolute inset-0 opacity-[0.5]" aria-hidden="true"
                        style="background-image:linear-gradient(rgba(166,210,230,0.18) 1px,transparent 1px),linear-gradient(90deg,rgba(166,210,230,0.18) 1px,transparent 1px);background-size:42px 42px;"></div>
                      <div class="absolute left-[58%] top-1/2 h-[136%] w-auto -translate-x-1/2 -translate-y-1/2 aspect-square">
                        <div class="absolute inset-[14%] rounded-full bg-cwru-true/25 blur-[46px]"></div>
                        <Nanoparticle
                          class="relative h-full w-full transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-105"
                          widths={[320, 560]}
                          sizes="38vw"
                          strength={58}
                          saturate={0.6}
                        />
                      </div>
                      <p class="label absolute bottom-3 left-4 z-10 text-cwru-light/55">Illustrative render</p>
                    </div>
                  ) : (
                    <RevealImage
                      id={CARD_IMAGE[t.id] ?? ''}
                      ratio="21 / 9"
                      interactive
                      desaturate={0.15}
                      sizes="(min-width: 640px) 38vw, 100vw"
                    />
                  )}
                  <div class="flex flex-1 flex-col p-8">
                    <p class="label text-copper tabular">{String(i + 1).padStart(2, '0')}</p>
                    <h3 class="mt-3 text-h3 text-cwru-dark">{t.data.title}</h3>
                    <p class="mt-3 text-[0.93rem] leading-relaxed text-ink-soft">{t.data.summary}</p>
                    <span class="mt-6 inline-flex items-center gap-1.5 text-[0.84rem] font-medium text-cwru-blue">
                      Read more
                      <ArrowRight className="size-3.5 transition-transform duration-200 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- News + publications -->
  <section class="mx-auto max-w-[78rem] px-5 py-20 sm:px-8 sm:py-24">
    <div class="grid gap-x-14 gap-y-16 lg:grid-cols-2">
      <div data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-rule pb-4">
          <div class="flex items-baseline gap-3">
            <span class="label text-copper tabular">03</span>
            <h2 class="text-h2 text-cwru-dark">In the news</h2>
          </div>
          <a class="group inline-flex items-center gap-1.5 text-[0.88rem] font-medium text-cwru-blue" href="/news">
            All news
            <ArrowRight className="size-3.5 transition-transform duration-200 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>
        <ul class="mt-6">{news.map((item) => <NewsItem item={item} />)}</ul>
      </div>

      <div data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-rule pb-4">
          <div class="flex items-baseline gap-3">
            <span class="label text-copper tabular">04</span>
            <h2 class="text-h2 text-cwru-dark">Recent publications</h2>
          </div>
          <a class="group inline-flex items-center gap-1.5 text-[0.88rem] font-medium text-cwru-blue" href="/publications">
            All publications
            <ArrowRight className="size-3.5 transition-transform duration-200 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>
        <ul class="mt-6">{pubs.map((pub) => <PublicationItem pub={pub} />)}</ul>
      </div>
    </div>
  </section>

  <!-- Lab overview video, kept for the archive and labelled with its age. -->
  <section class="border-t border-rule bg-warm">
    <div class="mx-auto max-w-[78rem] px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
        <SectionHead label="Archive" index="05" />
        <div class="grid gap-x-10 gap-y-5 md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] md:items-start">
          <div class="overflow-hidden border border-rule bg-black">
            <iframe
              class="block aspect-video w-full"
              src={`https://www.youtube-nocookie.com/embed/${SITE.videoId}`}
              title="Center for Biomolecular Engineering — lab overview"
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
          <div>
            <h2 class="font-serif text-[1.18rem] font-[550] text-cwru-dark">Lab overview</h2>
            <p class="mt-2 max-w-[46ch] text-[0.92rem] leading-relaxed text-ink-mute">
              Carried over from the Center's previous site. The clip predates the
              current group and is kept here for the archive rather than as a
              current introduction.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
