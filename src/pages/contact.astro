---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { CONTACT } from '../lib/site';

const mapQuery = encodeURIComponent('Wickenden Building, Case Western Reserve University, Cleveland, OH 44106');
---

<Base title="Contact" description="How to reach the Center for Biomolecular Engineering at Case Western Reserve University.">
  <PageHeader eyebrow="Contact" title="Find us" lede="The Center is located in the Wickenden Building on the Case Western Reserve University campus in Cleveland, Ohio." />

  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <section class="border-b border-rule py-14">
      <div class="grid gap-x-14 gap-y-10 lg:grid-cols-2" data-reveal>
        <div>
          <h2 class="label text-ink-mute">Director</h2>
          <p class="mt-3 font-serif text-[1.35rem] text-cwru-dark">{CONTACT.director}</p>

          <dl class="mt-7 space-y-5 text-[0.95rem]">
            <div>
              <dt class="label text-ink-mute">Office</dt>
              <dd class="mt-1 text-ink-soft">{CONTACT.office}</dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Laboratory</dt>
              <dd class="mt-1 text-ink-soft">{CONTACT.lab}</dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Phone</dt>
              <dd class="mt-1">
                <a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
              </dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Email</dt>
              <dd class="mt-1">
                <a class="break-all text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              </dd>
            </div>
            <div>
              <dt class="label text-ink-mute">Mailing address</dt>
              <dd class="mt-1">
                <address class="space-y-0.5 not-italic leading-relaxed text-ink-soft">
                  {CONTACT.mailing.map((line) => <div>{line}</div>)}
                </address>
              </dd>
            </div>
          </dl>
        </div>

        <div>
          <h2 class="label text-ink-mute">Location</h2>
          <!-- Google's keyless embed. The Maps Embed API proper wants a
               billed API key, which this site has no reason to carry; the
               `output=embed` form needs none and renders the same panel.
               Lazy, so an iframe that is well below the fold on a contact page
               cannot cost anything at load. -->
          <div class="mt-3 overflow-hidden rounded-card border border-rule bg-warm-deep/70" style="aspect-ratio: 4 / 3;">
            <iframe
              title="Map showing the Wickenden Building, Case Western Reserve University"
              src={`https://maps.google.com/maps?q=${mapQuery}&z=16&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="h-full w-full"
              style="border:0;"
            ></iframe>
          </div>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
            rel="noopener"
            class="mt-4 inline-block rounded-card border border-cwru-blue/35 px-4 py-2.5 shadow-card transition-shadow hover:shadow-lift text-[0.9rem] font-medium text-cwru-blue transition-colors hover:border-cwru-blue hover:bg-warm"
            >Open in Google Maps &rarr;</a
          >
        </div>
      </div>
    </section>

    <section class="py-14">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
        <h2 class="pt-1 label text-ink-mute lg:text-right">
          Instruments
        </h2>
        <div class="prose-lab">
          <p>
            Inquiries about training on, or use of, the Center's shared instruments should be
            directed to {CONTACT.instrumentsContact} at{' '}
            <a href={`mailto:${CONTACT.instrumentsEmail}`}>{CONTACT.instrumentsEmail}</a>. See the{' '}
            <a href="/instruments">instruments page</a> for the full list.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
