---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { CONTACT } from '../lib/site';
---

<Base title="Join the lab" description="Open positions in the Center for Biomolecular Engineering at Case Western Reserve University.">
  <PageHeader labPhoto="lab_work"
    eyebrow="Join"
    title="Open positions"
    lede="We are looking for scientists interested in nucleic acid delivery and targeted imaging agents."
  />

  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <section class="border-b border-rule py-14">
      <div class="grid gap-x-12 gap-y-8 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
        <p class="pt-2 label text-copper lg:text-right">
          Postdoctoral
        </p>
        <div>
          <h2 class="max-w-[24ch] text-h2 text-cwru-dark">
            Postdoctoral position in Biomedical Engineering
          </h2>
          <div class="prose-lab mt-6">
            <p>
              A postdoctoral position is available in the Department of Biomedical Engineering at
              the Case Western Reserve University to study novel targeted imaging agents for
              molecular imaging and novel delivery systems of nucleic acids for gene regulation,
              editing and therapy.
            </p>
            <h3 class="prose-label">Requirements</h3>
            <p>
              Experience in biomolecular engineering, drug delivery, molecular imaging, synthetic
              chemistry, synthetic biology, molecular biology, or cancer biology is required.
            </p>
            <h3 class="prose-label">How to apply</h3>
            <p>
              To apply for a position, please send a curriculum vitae and names of references to
              Dr. Zheng-Rong Lu at{' '}
              <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
            </p>
          </div>

          <div class="mt-9 max-w-[46rem] rounded-card border border-rule bg-warm p-7 shadow-card">
            <p class="label text-ink-mute">
              Send applications to
            </p>
            <address class="mt-3 space-y-0.5 text-[0.95rem] not-italic leading-relaxed text-ink-soft">
              <div class="font-serif text-[1.1rem] text-cwru-dark">Zheng-Rong Lu, Ph.D.</div>
              <div>M. Frank Rudy and Margaret Domiter Rudy Professor of Biomedical Engineering</div>
              {CONTACT.mailing.map((line) => <div>{line}</div>)}
              <div class="pt-2">
                Phone: <a class="text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
              </div>
              <div>
                Email: <a class="break-all text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              </div>
            </address>
          </div>

          <p class="mt-8 max-w-[62ch] text-[0.92rem] leading-relaxed text-ink-mute">
            Case Western Reserve University is building a culturally diverse faculty and strongly
            encourages applications from female and minority candidates.
          </p>
        </div>
      </div>
    </section>

    <section class="py-14">
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[11rem_minmax(0,1fr)]" data-reveal>
        <p class="pt-2 label text-ink-mute lg:text-right">
          Students
        </p>
        <div class="prose-lab">
          <p>
            <strong>TODO: content pending.</strong> The Center's previous site listed no guidance for
            prospective graduate or undergraduate students. Text describing how PhD applicants and
            undergraduate researchers should approach the lab needs to be written and confirmed
            before this section goes live.
          </p>
          <p>
            In the meantime, prospective students are welcome to contact Dr. Lu directly at{' '}
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
