---
import { ArrowUpRight } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';

interface Props { item: CollectionEntry<'news'>; showKind?: boolean }
const { item, showKind = false } = Astro.props;
const d = item.data;

const dateLabel = d.date
  ? d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
  : String(d.year);
const meta = [d.outlet, dateLabel].filter(Boolean).join(' · ');
---

<li class="group rule-top py-5 first:border-t-0 first:pt-0" data-reveal-item>
  <p class="label text-ink-mute">
    {meta}
    {showKind && d.kind === 'announcement' && <span class="text-copper"> · Lab news</span>}
  </p>

  {d.url ? (
    <a href={d.url} rel="noopener" class="mt-2 block font-serif text-[1.04rem] font-[550] leading-snug text-cwru-dark transition-colors duration-200 hover:text-cwru-blue">
      <span
        class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat pb-[2px] transition-[background-size] duration-300 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:bg-[length:100%_1px]"
        >{d.title}</span
      ><ArrowUpRight
        className="ml-1 inline size-[13px] shrink-0 -translate-y-[1px] text-ink-mute transition-all duration-200 group-hover:-translate-y-[3px] group-hover:text-cwru-blue"
        strokeWidth={1.75}
        aria-hidden="true"
      />
    </a>
  ) : (
    <p class="mt-2 font-serif text-[1.04rem] font-[550] leading-snug text-cwru-dark">{d.title}</p>
  )}
</li>
