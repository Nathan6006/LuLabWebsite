---
import Atmosphere from './Atmosphere.astro';
import LabBanner from './LabBanner.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  index?: string;
  /** Optional Unsplash slot id for a treated background. */
  atmosphere?: string;
  /** Optional id from the lab's own photographs — preferred over `atmosphere`. */
  labPhoto?: string;
}
const { eyebrow, title, lede, index, atmosphere, labPhoto } = Astro.props;
---

<!-- Asymmetric section header. The mono label hangs in a narrow left rail on
     wide screens with a hairline running under the whole block; the title runs
     long and breaks out of the text column. -->
<div class="relative border-b border-rule bg-warm">
  {labPhoto ? <LabBanner id={labPhoto} /> : atmosphere && <Atmosphere id={atmosphere} strength={40} loading="eager" />}
  <div class="relative mx-auto max-w-[78rem] px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-x-12 gap-y-4 lg:grid-cols-[11rem_minmax(0,1fr)]">
      {eyebrow && (
        <div class="flex items-baseline gap-3 pt-2 lg:flex-col lg:items-end lg:gap-1.5">
          <p class="label text-copper">{eyebrow}</p>
          {index && <p class="label text-ink-mute/70 tabular">{index}</p>}
        </div>
      )}
      <div class={eyebrow ? '' : 'lg:col-start-2'}>
        <h1 class="text-h1 max-w-[17ch] text-cwru-dark">{title}</h1>
        {lede && <p class="mt-6 max-w-[58ch] text-lede text-ink-soft">{lede}</p>}
        <slot />
      </div>
    </div>
  </div>
</div>
