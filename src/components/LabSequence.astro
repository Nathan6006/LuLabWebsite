---
import { Image } from 'astro:assets';
import { allLabPhotos } from '../lib/lab';

/**
 * The home page centrepiece: the lab's four photographs, pinned and cross-cut
 * as you scroll through them.
 *
 * The section pins for four viewport-heights. Each photograph scales down out
 * of an overscale and cross-dissolves into the next while its caption and index
 * swap, so the sequence reads as one continuous shot rather than four separate
 * reveals. Scrubbed, so the visitor is driving it — nothing plays on its own.
 *
 * Falls back to a plain stacked grid when JavaScript or motion is unavailable,
 * which is also what the mobile layout uses: pinning a section on a phone
 * fights the scroll and never feels good.
 */
const photos = allLabPhotos();
---

{photos.length > 0 && (
  <section class="lab-seq relative bg-cwru-dark text-white" data-lab-seq>
    <!-- Pinned stage (desktop). --><div class="lab-seq-stage relative h-[100svh] w-full overflow-hidden">
      <div class="absolute inset-0">
        {photos.map((p, i) => (
          <figure
            class="lab-seq-frame absolute inset-0"
            data-seq-frame
            data-seq-index={i}
          >
            <Image
              src={p.src}
              alt={p.meta.alt}
              widths={[880, 1400, 1920]}
              sizes="100vw"
              quality={62}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-cwru-dark/92 via-cwru-dark/25 to-cwru-dark/45"></div>
          </figure>
        ))}
      </div>

      <!-- Caption rail, swapped in step with the frames. -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0">
        <div class="mx-auto max-w-[78rem] px-5 pb-14 sm:px-8 sm:pb-20">
          <p class="label text-cwru-light">In the lab</p>
          <div class="relative mt-3 h-[7rem] sm:h-[8.2rem]">
            {photos.map((p, i) => (
              <p
                class="lab-seq-caption absolute inset-x-0 top-0 max-w-[24ch] font-serif text-[1.55rem] leading-[1.15] sm:text-[2rem]"
                data-seq-caption
                data-seq-index={i}
              >{p.meta.caption}</p>
            ))}
          </div>

          <!-- Progress ticks. -->
          <div class="mt-6 flex items-center gap-2">
            {photos.map((_, i) => (
              <span class="relative h-px w-10 overflow-hidden bg-white/25">
                <span class="lab-seq-tick absolute inset-0 origin-left scale-x-0 bg-copper" data-seq-tick data-seq-index={i}></span>
              </span>
            ))}
            <span class="label ml-3 text-white/55 tabular" data-seq-counter>01 / {String(photos.length).padStart(2, '0')}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Static fallback: what mobile and no-JS get. -->
    <div class="lab-seq-fallback mx-auto max-w-[78rem] px-5 py-16 sm:px-8">
      <p class="label text-cwru-light">In the lab</p>
      <ul class="mt-6 grid gap-6 sm:grid-cols-2">
        {photos.map((p) => (
          <li>
            <div class="overflow-hidden">
              <Image src={p.src} alt={p.meta.alt} widths={[520, 900]} sizes="(min-width:640px) 45vw, 100vw" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
            </div>
            <p class="mt-2.5 text-[0.9rem] text-white/70">{p.meta.caption}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
