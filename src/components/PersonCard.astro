---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';

interface Props { person: CollectionEntry<'people'> }
const { person } = Astro.props;
const d = person.data;
---

<article class="group">
  <Placeholder
    ratio="4 / 5"
    compact
    caption={d.photoNote ?? `Portrait of ${d.name}`}
    class="mb-3"
  />
  <h3 class="font-serif text-[1.08rem] leading-snug text-cwru-dark">
    {d.name}{d.credentials && <span class="text-ink-mute">, {d.credentials}</span>}
  </h3>
  <p class="mt-0.5 text-[0.86rem] text-ink-mute">{d.role}</p>
  {d.email && (
    <a
      class="mt-1 inline-block break-all text-[0.82rem] text-cwru-blue underline underline-offset-2 decoration-cwru-blue/40 hover:decoration-current"
      href={`mailto:${d.email}`}>{d.email}</a>
  )}
</article>
