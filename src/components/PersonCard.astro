---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';

interface Props { person: CollectionEntry<'people'> }
const { person } = Astro.props;
const d = person.data;
---

<article class="group" data-reveal-item>
  <Placeholder
    ratio="4 / 5"
    compact
    caption={d.photoNote ?? `Portrait of ${d.name}`}
    class="mb-3.5"
  />
  <h3 class="font-serif text-[1.02rem] font-[550] leading-snug text-cwru-dark">
    {d.name}{d.credentials && <span class="font-[400] text-ink-mute">, {d.credentials}</span>}
  </h3>
  <p class="mt-1 text-[0.84rem] leading-snug text-ink-mute">{d.role}</p>
  {d.email && (
    <a
      class="mt-1.5 inline-block break-all font-mono text-[0.72rem] tracking-tight link-underline hover:link-underline-hover"
      href={`mailto:${d.email}`}>{d.email}</a>
  )}
</article>
