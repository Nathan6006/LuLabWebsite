---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowDown } from 'lucide-react';
import ParticleField from '../components/ParticleField.tsx';
import { labPhoto } from '../lib/lab';
import Nanoparticle from './Nanoparticle.astro';

/**
 * The home page opening.
 *
 * The page loads with the nanoparticle close enough to fill most of the frame.
 * Scrolling the first viewport pulls it back and lifts the masthead away, while
 * the site title takes over in the header — so the hero's one big move happens
 * during the scroll you were doing anyway to get past it, and costs no extra
 * page height.
 *
 * There is deliberately no cursor tracking here. Planes drifting under the
 * pointer read as fidget rather than as depth, and it competed with the pull
 * back for the same attention.
 */
const plate = labPhoto('tube-rack');
---

<section
  class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-cwru-dark"
  data-hero-scene
>
  {plate && (
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={plate.src}
        alt=""
        widths={[880, 1400, 1920]}
        sizes="100vw"
        quality={58}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-plate h-full w-full scale-[1.16] object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-cwru-dark via-cwru-dark/92 to-cwru-dark/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-cwru-dark via-cwru-dark/35 to-cwru-dark/70"></div>
    </div>
  )}

  <!-- Particle drift. client:idle, not client:visible: the island renders null
       until it has confirmed a WebGL context, so it has no box for an
       IntersectionObserver to see and client:visible would never fire. -->
  <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true" data-hero-particles>
    <ParticleField client:idle />
  </div>

  <!-- The nanoparticle sits behind the type and pulls back with the scroll. On
       load it is close in and bleeding off the right edge. -->
  <div
    class="pointer-events-none absolute inset-y-0 right-[-12%] hidden w-[62%] items-center lg:flex"
    aria-hidden="true"
    data-hero-lnp
  >
    <div class="relative aspect-square w-full">
      <div class="absolute inset-[14%] rounded-full bg-cwru-true/20 blur-[90px]"></div>
      <div class="absolute inset-[28%] rounded-full bg-cwru-light/14 blur-[60px]"></div>
      <Nanoparticle
        class="relative h-full w-full"
        widths={[560, 900]}
        sizes="62vw"
        loading="eager"
        strength={84}
        saturate={0.32}
      />
    </div>
  </div>

  <!-- Scrims over the render, not under it. The particle is large enough to
       reach both the nav and the masthead, and white type on its pale shell
       does not clear AA on its own. -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-r from-cwru-dark via-cwru-dark/72 to-transparent"></div>
    <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-cwru-dark via-cwru-dark/70 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-cwru-dark to-transparent"></div>
  </div>

  <div class="relative mx-auto w-full max-w-[78rem] px-5 py-28 sm:px-8" data-hero-content>
    <div class="max-w-[46rem]">
      <div class="flex items-center gap-3" data-hero-follow>
        <span class="h-px w-8 bg-copper"></span>
        <p class="label text-cwru-light">Case Western Reserve University</p>
      </div>

      <h1
        data-hero-title
        class="hero-title mt-7 max-w-[11ch] text-display font-[440] leading-[1.02] tracking-[-0.03em] text-white"
      >Center for Biomolecular Engineering</h1>

      <p class="mt-6 max-w-[40ch] text-lede text-white/80" data-hero-follow>
        Nanoplatforms that carry nucleic acid therapeutics where they need to go,
        and imaging agents that show clinicians the disease before it spreads.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3" data-hero-follow>
        <a
          href="/research"
          data-magnet
          class="group relative inline-flex items-center gap-2 overflow-hidden bg-white px-7 py-4 text-[0.92rem] font-medium text-cwru-dark"
        >
          <span class="relative z-10">Explore our research</span>
          <ArrowRight className="relative z-10 size-4 transition-transform duration-300 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
          <span class="absolute inset-0 origin-left scale-x-0 bg-cwru-light transition-transform duration-400 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-x-100"></span>
        </a>
        <a href="/join" class="group inline-flex items-center gap-2 py-4 text-[0.92rem] font-medium text-white">
          <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:100%_1px] bg-left-bottom bg-no-repeat pb-[3px] transition-[background-size] duration-300 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:bg-[length:0%_1px]">Open positions</span>
          <ArrowRight className="size-4 transition-transform duration-200 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <a
    href="#approach"
    class="absolute inset-x-0 bottom-8 z-10 mx-auto flex w-fit items-center gap-2 text-white/45 transition-colors duration-200 hover:text-white"
    data-hero-follow
  >
    <ArrowDown className="size-3.5 animate-[nudge_2.4s_ease-in-out_infinite]" strokeWidth={1.75} aria-hidden="true" />
    <span class="label">Scroll</span>
  </a>
</section>
