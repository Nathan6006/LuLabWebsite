---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowDown } from 'lucide-react';
import ParticleField from '../components/ParticleField.tsx';
import { labPhoto } from '../lib/lab';
import Nanoparticle from './Nanoparticle.astro';
import { SITE } from '../lib/site';

/**
 * The home page opening: four depth planes that move at different rates under
 * the cursor, so the whole thing sits in space rather than flat on the page.
 *
 *   0  the lab photograph, graded almost to black
 *   1  a WebGL particle drift
 *   2  the masthead and copy
 *   3  the nanoparticle render, floating nearest the viewer
 */
const plate = labPhoto('tube-rack');
---

<section
  class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-cwru-dark"
  data-hero-scene
>
  {plate && (
    <div class="absolute inset-0" aria-hidden="true" data-depth="0.018">
      <Image
        src={plate.src}
        alt=""
        widths={[880, 1400, 1920]}
        sizes="100vw"
        quality={58}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-plate h-full w-full scale-[1.06] object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-cwru-dark via-cwru-dark/92 to-cwru-dark/55"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-cwru-dark via-cwru-dark/35 to-cwru-dark/70"></div>
    </div>
  )}

  <!-- Particle drift. client:idle, not client:visible: the island renders null
       until it has confirmed a WebGL context, so it has no box for an
       IntersectionObserver to see and client:visible would never fire. -->
  <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
    <ParticleField client:idle />
  </div>

  <div class="relative mx-auto grid w-full max-w-[78rem] items-center gap-x-12 gap-y-14 px-5 py-28 sm:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
    <div data-depth="0.055">
      <div class="flex items-center gap-3" data-hero-follow>
        <span class="h-px w-8 bg-copper"></span>
        <p class="label text-cwru-light">Case Western Reserve University</p>
      </div>

      <h1
        data-hero-title
        class="mt-7 max-w-[12ch] text-display font-[440] leading-[1.02] tracking-[-0.03em] text-white"
      >Center for Biomolecular Engineering</h1>

      <p class="mt-8 max-w-[42ch] text-lede text-white/80" data-hero-follow>
        Nanoplatforms that carry nucleic acid therapeutics where they need to go,
        and imaging agents that show clinicians the disease before it spreads.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3" data-hero-follow>
        <a
          href="/research"
          data-magnet
          class="group relative inline-flex items-center gap-2 overflow-hidden bg-white px-7 py-4 text-[0.92rem] font-medium text-cwru-dark"
        >
          <span class="relative z-10">Explore our research</span>
          <ArrowRight className="relative z-10 size-4 transition-transform duration-300 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
          <span class="absolute inset-0 origin-left scale-x-0 bg-cwru-light transition-transform duration-400 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-x-100"></span>
        </a>
        <a href="/join" class="group inline-flex items-center gap-2 py-4 text-[0.92rem] font-medium text-white">
          <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:100%_1px] bg-left-bottom bg-no-repeat pb-[3px] transition-[background-size] duration-300 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:bg-[length:0%_1px]">Open positions</span>
          <ArrowRight className="size-4 transition-transform duration-200 group-hover:translate-x-1" strokeWidth={1.75} aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- The nanoparticle, nearest the viewer. -->
    <div class="relative hidden lg:block" data-depth="0.11" data-hero-follow>
      <div class="relative mx-auto aspect-square w-full max-w-[30rem]">
        <div class="absolute inset-[8%] rounded-full bg-cwru-true/22 blur-[70px]"></div>
        <div class="absolute inset-[22%] rounded-full bg-cwru-light/18 blur-[50px]"></div>
        <Nanoparticle
          class="relative h-full w-full"
          widths={[380, 620]}
          sizes="30rem"
          loading="eager"
          strength={58}
        />
      </div>
      <p class="label mt-2 text-center text-white/40">
        ECO lipid nanoparticle &middot; illustrative render
      </p>
    </div>
  </div>

  <a
    href="#approach"
    class="absolute inset-x-0 bottom-8 mx-auto flex w-fit items-center gap-2 text-white/45 transition-colors duration-200 hover:text-white"
    data-hero-follow
  >
    <ArrowDown className="size-3.5 animate-[nudge_2.4s_ease-in-out_infinite]" strokeWidth={1.75} aria-hidden="true" />
    <span class="label">Scroll</span>
  </a>
</section>
