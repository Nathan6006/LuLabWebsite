---
import MoleculeCanvas from './MoleculeCanvas.tsx';
import Nanoparticle from './Nanoparticle.astro';

/**
 * The page's signature moment. The stage pins to the viewport and the scroll
 * wheel stops moving the page — it drives an internal progress value instead.
 * On the left a WebGL point cloud morphs between three structures; on the right
 * the three panels take turns explaining them.
 *
 * Everything here is index-driven from one progress value, so scrubbing
 * backwards reverses the whole section exactly. The pin, the scrub and the
 * canvas driver live in Motion.astro.
 *
 * Below 1024px, and for anyone who asked for reduced motion, none of this
 * exists: the fallback underneath is the same three panels stacked, with the
 * static render, and it is what ships without JavaScript.
 *
 * The copy is drawn from the Center's own research pages. The structures are
 * schematic — see the caption and TODO.md.
 */

const STAGES = [
  {
    index: '01',
    label: 'Nucleic acid delivery',
    title: 'A carrier built to come apart',
    body:
      'ECO is a pH-sensitive multifunctional lipid: a protonable ethylenediamine head group, two cysteine-based linkers, two oleic acid tails. It condenses siRNA or plasmid DNA electrostatically, locks the particle with reversible disulfides, and holds it together hydrophobically.',
    note: 'Lipid shell condensed around a nucleic acid cargo',
  },
  {
    index: '02',
    label: 'Molecular imaging',
    title: 'Probes that report the microenvironment',
    body:
      'The same design discipline, turned to a different job. Contrast agents are built around a chelated metal centre rather than a cargo compartment — the structure exists to hold the reporting atom in place and to be cleared afterwards, not to deliver anything into a cell.',
    note: 'Macrocyclic chelate, metal centre held by four pendant arms',
  },
  {
    index: '03',
    label: 'Targeting',
    title: 'Docking onto the remodelled matrix',
    body:
      'The tumour microenvironment is heavily remodelled during cancer progression. Our probes target fibronectin, an extracellular matrix molecule that helps drive that progression, and in doing so detect aggressive breast and prostate cancer with sensitivity and specificity beyond the clinical agents.',
    note: 'Targeting peptide bound to a fibronectin fibril',
  },
];
---

<section class="platform relative" data-platform>
  <!-- Pinned stage. Starts on the warm ground of the section above and darkens
       into it as you enter, so the page reads as having architecture rather
       than being one continuous scroll of cards. -->
  <div
    class="platform-stage relative isolate min-h-[100svh] overflow-hidden bg-cwru-dark"
    data-platform-stage
  >
    <div class="pointer-events-none absolute inset-0 opacity-[0.16]" aria-hidden="true" data-platform-grid>
      <div
        class="h-full w-full"
        style="background-image:linear-gradient(rgba(166,210,230,0.4) 1px,transparent 1px),linear-gradient(90deg,rgba(166,210,230,0.4) 1px,transparent 1px);background-size:78px 78px;"
      >
      </div>
    </div>

    <div class="relative mx-auto grid h-[100svh] w-full max-w-[86rem] grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] items-center gap-x-10 px-8">
      <!-- Canvas column -->
      <div class="relative h-full">
        <div class="absolute inset-0" data-molecule-host>
          <MoleculeCanvas client:idle />
        </div>
        <p
          class="label absolute inset-x-0 bottom-10 text-center text-white/35"
          data-platform-caption
        >
          Schematic &middot; illustrative, not to scale
        </p>
      </div>

      <!-- Panels. Stacked in one box; exactly one is active at a time. -->
      <div class="relative py-16" data-platform-panels>
        <div class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-6">
          <!-- The rail draws itself as the section advances, and each marker
               lights as the line reaches it. -->
          <svg
            class="h-[19rem] w-[2.5rem] self-start"
            viewBox="0 0 40 304"
            fill="none"
            aria-hidden="true"
            data-platform-rail
          >
            <line x1="20" y1="10" x2="20" y2="294" stroke="rgba(166,210,230,0.18)" stroke-width="1" />
            <line
              x1="20" y1="10" x2="20" y2="294"
              stroke="#c4381c" stroke-width="2" stroke-linecap="round"
              data-rail-path
            />
            {STAGES.map((_, i) => (
              <circle
                cx="20" cy={10 + i * 142} r="4.5"
                fill="#09143a" stroke="#a6d2e6" stroke-width="1.5"
                data-rail-node
              />
            ))}
          </svg>

          <div class="relative min-h-[24rem]">
            {STAGES.map((s) => (
              <article
                class="platform-panel"
                data-platform-panel
              >
                <p class="label text-copper-brand tabular">{s.index} &nbsp;/&nbsp; {s.label}</p>
                <h2 class="mt-5 max-w-[16ch] text-h1 font-[460] leading-[1.08] text-white">
                  {s.title}
                </h2>
                <p class="mt-6 max-w-[46ch] text-[1.02rem] leading-[1.62] text-cwru-light/85">
                  {s.body}
                </p>
                <p class="label mt-8 text-white/40">{s.note}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fallback: no pin, no canvas, same three panels. -->
  <div class="platform-fallback bg-cwru-dark">
    <div class="mx-auto max-w-[78rem] px-5 py-20 sm:px-8 sm:py-24">
      <p class="label text-copper-brand">The platform</p>
      <div class="mt-10 grid gap-x-12 gap-y-12 md:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] md:items-start">
        <div class="relative mx-auto aspect-square w-full max-w-[18rem]">
          <div class="absolute inset-[12%] rounded-full bg-cwru-true/20 blur-[60px]"></div>
          <Nanoparticle class="relative h-full w-full" widths={[320, 560]} sizes="18rem" strength={54} />
        </div>
        <ol class="space-y-12">
          {STAGES.map((s) => (
            <li>
              <p class="label text-copper-brand tabular">{s.index} &nbsp;/&nbsp; {s.label}</p>
              <h2 class="mt-3 text-h3 text-white">{s.title}</h2>
              <p class="mt-3 max-w-[52ch] text-[0.97rem] leading-relaxed text-cwru-light/80">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
