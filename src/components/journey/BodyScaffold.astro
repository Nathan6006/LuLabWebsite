---
/**
 * The scene: the curve, the body, and the trail. Markup and IDs only — every
 * animated property is written by stage.ts, and nothing here moves on its own.
 *
 * The composition runs LEFT TO RIGHT. The nanoparticle starts at the left end
 * of the curve; the body sits on the right; the curve is the route between
 * them and continues unbroken into the torso as the vessel. It is one path
 * from end to end, which is what removes the seam the previous version had
 * between "outside" and "inside" the body.
 *
 * The curve is also the progress indicator. Behind the particle it is lit, in
 * front of it dim, so while the section is pinned and the page is not moving
 * the reader can still see how far through they are. One object doing both
 * jobs, rather than a rail and a route competing for attention.
 *
 * The figure is human, front view, abstract line art. Light on a dark ground.
 * The target is a glow with no label, no outline and no organ under it — the
 * animation identifies nothing and therefore claims nothing.
 *
 * DEFAULT STATE IS THE FINISHED COMPOSITION. Strokes are undashed and the
 * curve is filled, so the section is a complete picture with no JavaScript at
 * all. The controller rewinds it only once it has confirmed it can drive it.
 */
import { JOURNEY } from '../../lib/journey';

const [vw, vh] = JOURNEY.geometry.viewBox;
const [tx, ty] = JOURNEY.geometry.target;
const C = JOURNEY.colors;

// The figure is authored in its own 400x640 space and placed into the scene,
// so its proportions are independent of where it sits.
const BODY_SCALE = 1.24;
const BODY_X = 930;
const BODY_Y = 76;
---

<svg
  class="journey-svg h-full w-full"
  viewBox={`0 0 ${vw} ${vh}`}
  fill="none"
  aria-hidden="true"
  data-journey-svg
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <radialGradient id="jrn-target-glow">
      <stop offset="0%" stop-color={C.amberBright} stop-opacity="0.5" />
      <stop offset="60%" stop-color={C.amber} stop-opacity="0.12" />
      <stop offset="100%" stop-color={C.amber} stop-opacity="0" />
    </radialGradient>
    <radialGradient id="jrn-pulse-glow">
      <stop offset="0%" stop-color={C.amberBright} stop-opacity="0.85" />
      <stop offset="45%" stop-color={C.amber} stop-opacity="0.3" />
      <stop offset="100%" stop-color={C.amber} stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Everything in the scene rides one camera. The transform is written by
       stage.ts from the same camera value the WebGL particle uses. -->
  <g data-journey-camera>
    <!-- The figure. Stroke widths are in scene units, so they scale with the
         camera exactly as the rest of the drawing does. -->
    <g
      data-journey-body
      transform={`translate(${BODY_X} ${BODY_Y}) scale(${BODY_SCALE})`}
      stroke={C.line}
      stroke-opacity={C.lineOpacity}
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        id="body-outline"
        d="M 200 28
           C 217 28 231 43 231 62
           C 231 79 222 92 212 96
           L 211 113
           C 233 117 250 123 258 135
           C 266 147 267 171 265 201
           C 263 233 255 253 251 273
           C 259 293 261 313 257 331
           C 240 341 160 341 143 331
           C 139 313 141 293 149 273
           C 145 253 137 233 135 201
           C 133 171 134 147 142 135
           C 150 123 167 117 189 113
           L 188 96
           C 178 92 169 79 169 62
           C 169 43 183 28 200 28 Z"
      />
      <path
        id="limb-outline"
        d="M 256 136
           C 276 146 292 178 300 212
           C 306 240 314 288 318 322
           C 320 336 322 348 320 356
           C 314 360 306 358 303 352
           C 298 340 294 318 290 296
           C 284 262 276 222 268 196
           C 262 176 254 158 248 146 Z
           M 144 136
           C 124 146 108 178 100 212
           C 94 240 86 288 82 322
           C 80 336 78 348 80 356
           C 86 360 94 358 97 352
           C 102 340 106 318 110 296
           C 116 262 124 222 132 196
           C 138 176 146 158 152 146 Z
           M 252 335
           C 254 385 250 430 247 470
           C 244 512 241 556 240 585
           C 246 592 258 594 262 599
           C 262 604 254 606 240 606
           L 226 606
           C 224 596 226 590 227 585
           C 226 556 224 512 222 470
           C 220 430 210 385 205 340 Z
           M 148 335
           C 146 385 150 430 153 470
           C 156 512 159 556 160 585
           C 154 592 142 594 138 599
           C 138 604 146 606 160 606
           L 174 606
           C 176 596 174 590 173 585
           C 174 556 176 512 178 470
           C 180 430 190 385 195 340 Z"
      />
    </g>

    <!-- The route, and the progress bar. One path, no subpaths: stage.ts
         samples it into a lookup table at refresh and never touches it again.
         It is never stroked directly — the segments below are what you see. -->
    <path
      id="vessel-path"
      data-journey-curve
      d="M 200 500
         C 268 452 330 470 392 512
         C 452 552 508 566 566 534
         C 624 502 660 428 722 412
         C 786 396 838 452 890 476
         C 944 500 992 486 1030 448
         C 1062 416 1086 372 1104 350
         C 1118 333 1130 325 1140 320"
      stroke="none"
      fill="none"
    />

    <!-- The curve, cut into segments so the tail can fade by arc length. SVG
         has no along-path gradient — a stroke gradient is spatial, not
         arc-length — so a single path cannot fade a comet correctly, and
         segmenting is also what keeps the fade a function of distance behind
         the particle rather than of elapsed time. -->
    <g
      id="trail-group"
      data-journey-trail
      stroke-linecap="round"
      fill="none"
    ></g>

    <!-- The target: an unlabelled glow. -->
    <g data-journey-target>
      <circle cx={tx} cy={ty} r="46" fill="url(#jrn-target-glow)" />
      <circle cx={tx} cy={ty} r="3" fill={C.amber} fill-opacity="0.5" />
    </g>

    <!-- One pulse on arrival. Scaled about the target, never repeated. -->
    <circle
      data-journey-pulse
      cx={tx}
      cy={ty}
      r="26"
      fill="url(#jrn-pulse-glow)"
      opacity="0"
      style={`transform-origin:${tx}px ${ty}px;transform-box:view-box;`}
    />
  </g>
</svg>
