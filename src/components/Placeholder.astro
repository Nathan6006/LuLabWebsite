---
import { ImageIcon } from 'lucide-react';

/**
 * A correctly-proportioned block standing in for a photograph that has not been
 * supplied yet. The caption names what belongs there. No stock photography and
 * nothing scraped — see TODO.md.
 */
interface Props {
  ratio?: string;
  caption: string;
  class?: string;
  compact?: boolean;
}
const { ratio = '4 / 5', caption, class: klass = '', compact = false } = Astro.props;
---

<figure class={klass}>
  <div
    class="relative flex items-center justify-center overflow-hidden rounded-card border border-rule bg-warm-deep/70"
    style={`aspect-ratio: ${ratio};`}
    role="img"
    aria-label={`Placeholder: ${caption}`}
  >
    <!-- Hairline cross-marks in the corners: a registration mark, not a card. -->
    <span class="pointer-events-none absolute left-2 top-2 h-3 w-px bg-rule"></span>
    <span class="pointer-events-none absolute left-2 top-2 h-px w-3 bg-rule"></span>
    <span class="pointer-events-none absolute bottom-2 right-2 h-3 w-px bg-rule"></span>
    <span class="pointer-events-none absolute bottom-2 right-2 h-px w-3 bg-rule"></span>
    <ImageIcon className="size-6 text-ink-mute/35" strokeWidth={1} aria-hidden="true" />
  </div>
  {!compact && (
    <figcaption class="mt-2.5 max-w-[42ch] text-[0.74rem] leading-snug text-ink-mute">
      {caption}
    </figcaption>
  )}
</figure>
