---
import { Image } from 'astro:assets';
import Nanoparticle from './Nanoparticle.astro';

/**
 * The centrepiece: the ECO nanoparticle held in the middle of the viewport and
 * turned in 3D as you scroll, while the three stages of its delivery mechanism
 * take turns around it.
 *
 * The stage text is the lab's own, taken verbatim from the Gene Therapy section
 * of their research page — this is how ECO actually works, not invented copy.
 * Rotation is a scrubbed CSS 3D transform rather than WebGL: one image and a
 * perspective is all this needs, and it stays sharp at any size.
 *
 * Below the pin breakpoint the same content reads as a plain numbered list.
 */
const stages = [
  {
    n: '01',
    title: 'Self-assembly',
    body: 'Stabilisation is achieved through the electrostatic condensation of the cationic head group with the negatively charged gene cargo, reversible disulfide formation through autoxidation of the cysteine groups, and hydrophobic condensation of the oleic acid lipid tails.',
    tag: 'Electrostatic + disulfide + hydrophobic',
  },
  {
    n: '02',
    title: 'Endosomal escape',
    body: 'Endocytic uptake of the nanoparticles is followed by pH-sensitive amphiphilic endosomal escape — the protonable ethylenediamine head group responds to the falling pH of the maturing endosome.',
    tag: 'pH-sensitive amphiphilicity',
  },
  {
    n: '03',
    title: 'Cytosolic release',
    body: 'Reductive cytosolic release delivers the genetic cargo — the PERC mechanism — freeing the nucleic acid to act once it is safely inside the cell.',
    tag: 'PERC · reductive release',
  },
];
---

<section class="nano relative bg-cwru-dark text-white" data-nano>
  <div class="nano-stage relative flex h-[100svh] w-full items-center overflow-hidden">
    <!-- Grid ground: a faint engineering grid, drawn not photographed. -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.16]"
      style="background-image:linear-gradient(rgba(166,210,230,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(166,210,230,.5) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse 70% 60% at 50% 50%,#000 20%,transparent 78%);-webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 50%,#000 20%,transparent 78%)"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto grid w-full max-w-[78rem] items-center gap-x-16 gap-y-10 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
      <!-- The particle, turning. -->
      <div class="relative order-2 lg:order-1" style="perspective: 1400px;">
        <div class="relative mx-auto aspect-square w-full max-w-[27rem]" data-nano-orbit>
          <div class="absolute inset-[10%] rounded-full bg-cwru-true/25 blur-[64px]" data-nano-glow></div>
          <Nanoparticle
            class="relative h-full w-full"
            widths={[420, 700]}
            sizes="27rem"
            strength={54}
            alt="Cross-section of a lipid nanoparticle: a PEG corona around a lipid shell, enclosing inverted micelles that carry nucleic acid cargo."
          />
        </div>
        <p class="label mt-4 text-center text-white/40">
          ECO lipid nanoparticle &middot; illustrative render
        </p>
      </div>

      <!-- Stage copy. -->
      <div class="order-1 lg:order-2">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-copper"></span>
          <p class="label text-copper">The delivery mechanism</p>
        </div>
        <h2 class="mt-5 max-w-[15ch] text-h2 text-white">How ECO carries its cargo</h2>

        <div class="relative mt-9 min-h-[19rem]">
          {stages.map((s, i) => (
            <article class="nano-stage-copy absolute inset-x-0 top-0" data-nano-copy data-i={i}>
              <p class="label text-cwru-light tabular">Stage {s.n}</p>
              <h3 class="mt-2.5 font-serif text-[1.7rem] font-[500] leading-tight text-white">{s.title}</h3>
              <p class="mt-4 max-w-[46ch] text-[0.97rem] leading-relaxed text-white/72">{s.body}</p>
              <p class="label mt-5 inline-block border border-white/20 px-3 py-1.5 text-white/55">{s.tag}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-2">
          {stages.map((_, i) => (
            <span class="relative h-px w-12 overflow-hidden bg-white/22">
              <span class="absolute inset-0 origin-left scale-x-0 bg-copper" data-nano-tick data-i={i}></span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Static fallback for small screens and no-JS. -->
  <div class="nano-fallback mx-auto max-w-[78rem] px-5 py-16 sm:px-8">
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bg-copper"></span>
      <p class="label text-copper">The delivery mechanism</p>
    </div>
    <h2 class="mt-5 max-w-[16ch] text-h2 text-white">How ECO carries its cargo</h2>

    <div class="mx-auto mt-10 max-w-[19rem]">
      <Nanoparticle widths={[320, 560]} sizes="19rem" strength={54} alt="Cross-section of a lipid nanoparticle." />
    </div>

    <ol class="mt-12 space-y-9">
      {stages.map((s) => (
        <li class="border-l-2 border-cwru-light/35 pl-6">
          <p class="label text-cwru-light tabular">Stage {s.n}</p>
          <h3 class="mt-2 font-serif text-[1.3rem] font-[500] text-white">{s.title}</h3>
          <p class="mt-3 max-w-[46ch] text-[0.95rem] leading-relaxed text-white/72">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
