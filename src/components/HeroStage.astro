---
import { Image } from 'astro:assets';
import { labPhoto } from '../lib/lab';

/**
 * The home page hero plate: one of the lab's own photographs, held behind the
 * masthead under a deep CWRU-blue grade so white type keeps its contrast.
 *
 * It drifts very slowly — a 24s scale from 1.0 to 1.08 — which is enough to
 * make the page feel alive on arrival without ever reading as motion. This is
 * the only looping animation on the site, and it stops for reduced-motion.
 */
interface Props { id: string }
const { id } = Astro.props;
const photo = labPhoto(id);
---

{photo && (
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Image
      src={photo.src}
      alt=""
      widths={[880, 1400, 1920]}
      sizes="100vw"
      quality={58}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-plate h-full w-full object-cover"
    />
    <!-- Grade: deep blue, heaviest at the left where the masthead sits. -->
    <div class="absolute inset-0 bg-gradient-to-r from-cwru-dark via-cwru-dark/88 to-cwru-dark/45"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-cwru-dark via-transparent to-cwru-dark/35"></div>
  </div>
)}
