---
/**
 * Site-wide motion layer, all GSAP, no framework.
 *
 * The home page carries the expensive work: a masthead that assembles and then
 * hands the site name to the header, a pinned section where the scroll wheel
 * drives a morphing point cloud instead of the page, a paragraph that brightens
 * a word at a time, and a horizontal photo strip. Every other page keeps the
 * quiet pair — a short rise per block, one mask wipe per image — plus the
 * progress bar.
 *
 * Bundle shape matters. The simple reveals only ever needed "is this on screen
 * yet", which IntersectionObserver answers natively, so they do not pull
 * ScrollTrigger in. ScrollTrigger and SplitText are dynamically imported and
 * only ever fetched by the home page.
 *
 * Rules enforced throughout:
 *  - Nothing above the fold is hidden by CSS. Pre-hiding the largest text block
 *    until this script ran pushed LCP from 1.7s to 3.5s.
 *  - Anything already on screen animates immediately rather than waiting for a
 *    scroll event that may never come.
 *  - Every scrubbed effect is a pure function of scroll position, so scrolling
 *    back up reverses it exactly.
 */
---

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fold = window.innerHeight * 0.9;
  const wide = window.matchMedia('(min-width: 1024px)').matches;

  /** Run `fn` once, now if the element is already on screen, else on approach. */
  function whenSeen(el: Element, fn: () => void, margin = '0px 0px -10% 0px') {
    if (el.getBoundingClientRect().top < fold) { fn(); return; }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.disconnect();
        fn();
      }
    }, { rootMargin: margin });
    io.observe(el);
  }

  /* ---- 0. Scroll progress ------------------------------------------------
     A hairline across the top. Transform only, so it never costs a layout. */
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  if (bar) {
    let ticking = false;
    const draw = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    };
    draw();
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(draw);
    }, { passive: true });
    window.addEventListener('resize', draw);
  }

  /* ---- 1. Block reveals ---------------------------------------------------
     Staggered by position in the grid rather than by DOM order, so a diagonal
     wave crosses the layout instead of a left-to-right sweep. 16px of travel:
     larger offsets read as the page assembling itself, which gets tiring by the
     third section. Fires once — re-animating on the way back up is the single
     fastest way to make this effect irritating. */
  if (!reduced) {
    for (const block of gsap.utils.toArray<HTMLElement>('[data-reveal]')) {
      if (block.getBoundingClientRect().top < fold) continue;
      const items = block.querySelectorAll<HTMLElement>('[data-reveal-item]');
      const subjects = items.length ? Array.from(items) : [block];
      whenSeen(block, () => {
        gsap.from(subjects, {
          y: 16, opacity: 0, duration: 0.66, ease: 'power3.out',
          stagger: items.length > 1 ? { amount: 0.34, grid: 'auto', from: 'start' } : 0,
          force3D: true,
          onComplete() { for (const s of subjects) s.style.willChange = 'auto'; },
        });
      });
    }
  }

  /* ---- 2. Image reveals ---------------------------------------------------
     A directional clip wipe, not a fade — a fade reads as a default. The
     picture scales 1.08 down to 1.0 underneath, so there is movement inside the
     frame as well as at its edge. */
  for (const frame of gsap.utils.toArray<HTMLElement>('[data-reveal-img]')) {
    const img = frame.querySelector('img');
    if (!img) continue;
    if (reduced) { frame.classList.add('is-revealed'); continue; }
    const play = () => {
      const tl = gsap.timeline({ onComplete: () => { img.style.willChange = 'auto'; } });
      tl.fromTo(frame, { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 0.9, ease: 'power3.inOut' }, 0);
      tl.fromTo(img, { scale: 1.08 }, { scale: 1, duration: 1.15, ease: 'power3.out', force3D: true }, 0);
      frame.classList.add('is-revealed');
    };
    if (frame.hasAttribute('data-reveal-img-immediate')) play();
    else whenSeen(frame, play);
  }

  /* ---- 3. Counters -------------------------------------------------------- */
  for (const el of gsap.utils.toArray<HTMLElement>('[data-count]')) {
    const target = Number(el.dataset.count);
    if (!Number.isFinite(target)) continue;
    if (reduced) { el.textContent = String(target); continue; }
    whenSeen(el, () => {
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target, duration: 1.5, ease: 'power2.out',
        onUpdate() { el.textContent = String(Math.round(obj.v)); },
      });
    });
  }

  /* ---- 4. Header over the hero -------------------------------------------- */
  const header = document.querySelector<HTMLElement>('[data-header][data-over-hero]');
  if (header) {
    const first = document.querySelector<HTMLElement>('main > section');
    const setSolid = () => {
      const past = first
        ? first.getBoundingClientRect().bottom <= header.offsetHeight + 8
        : window.scrollY > 40;
      header.classList.toggle('is-solid', past);
    };
    setSolid();
    window.addEventListener('scroll', setSolid, { passive: true });
    window.addEventListener('resize', setSolid);
  }

  /* ---- 5. Magnetic buttons ------------------------------------------------ */
  if (!reduced && window.matchMedia('(pointer: fine)').matches) {
    for (const btn of gsap.utils.toArray<HTMLElement>('[data-magnet]')) {
      const toX = gsap.quickTo(btn, 'x', { duration: 0.5, ease: 'power3.out' });
      const toY = gsap.quickTo(btn, 'y', { duration: 0.5, ease: 'power3.out' });
      btn.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        toX((e.clientX - r.left - r.width / 2) * 0.32);
        toY((e.clientY - r.top - r.height / 2) * 0.42);
      }, { passive: true });
      btn.addEventListener('pointerleave', () => { toX(0); toY(0); }, { passive: true });
    }
  }

  /* ---- 6. Card tilt + spotlight ------------------------------------------- */
  if (!reduced && window.matchMedia('(pointer: fine)').matches) {
    for (const card of gsap.utils.toArray<HTMLElement>('[data-tilt]')) {
      const rx = gsap.quickTo(card, 'rotateX', { duration: 0.5, ease: 'power3.out' });
      const ry = gsap.quickTo(card, 'rotateY', { duration: 0.5, ease: 'power3.out' });
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        ry((px - 0.5) * 7);
        rx((0.5 - py) * 5);
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
      }, { passive: true });
      card.addEventListener('pointerleave', () => { rx(0); ry(0); }, { passive: true });
    }
  }

  /* ---- 7. Home page ------------------------------------------------------
     Everything below is scrubbed, and both plugins are fetched here and
     nowhere else. */
  const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]');

  if (heroTitle && !reduced) {
    (async () => {
      const [{ SplitText }, { ScrollTrigger }] = await Promise.all([
        import('gsap/SplitText'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(SplitText, ScrollTrigger);

      /* -- 7a. Masthead assembles line by line out of its own masks -------- */
      if (document.fonts && document.fonts.status !== 'loaded') await document.fonts.ready;
      const split = new SplitText(heroTitle, { type: 'lines', linesClass: 'hero-line' });
      for (const line of split.lines) {
        const mask = document.createElement('span');
        mask.className = 'hero-line-mask';
        line.parentNode?.insertBefore(mask, line);
        mask.appendChild(line);
      }
      gsap.set(heroTitle, { opacity: 1 });
      gsap.from(split.lines, { yPercent: 118, duration: 1.05, ease: 'expo.out', stagger: 0.085 });
      gsap.from('[data-hero-follow]', {
        y: 18, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.09, delay: 0.42,
      });

      /* -- 7b. Camera pull back, and the title docks into the header -------
         The nanoparticle loads close in and recedes as you scroll the first
         viewport; the masthead lifts away and the header wordmark writes
         itself in as it goes. One title, two jobs, and no extra page height —
         it all plays during the scroll you were making anyway. */
      const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
      if (scene) {
        const heroTl = gsap.timeline({
          scrollTrigger: {
            trigger: scene, start: 'top top', end: 'bottom top',
            scrub: 0.5, invalidateOnRefresh: true,
          },
        });
        const lnp = scene.querySelector<HTMLElement>('[data-hero-lnp]');
        if (lnp) heroTl.fromTo(lnp,
          { scale: 1.28, xPercent: 0, yPercent: 0 },
          { scale: 0.84, xPercent: -9, yPercent: -6, ease: 'none', duration: 1 }, 0);
        heroTl.fromTo('.hero-plate', { scale: 1.16 }, { scale: 1.0, ease: 'none', duration: 1 }, 0);
        heroTl.fromTo('[data-hero-particles]', { opacity: 0.7 }, { opacity: 0, ease: 'none', duration: 1 }, 0);
        heroTl.fromTo('[data-hero-content]',
          { y: 0, opacity: 1 },
          { y: -80, opacity: 0, ease: 'power2.in', duration: 0.68 }, 0);

        // The wordmark arrives as the masthead leaves rather than at the very
        // last pixel of the hero, so the two never both read as the title and
        // never both read as missing.
        const dock = document.querySelector<HTMLElement>('[data-dock-title]');
        if (dock) {
          gsap.set(dock, { opacity: 0, y: 8 });
          heroTl.fromTo(dock,
            { opacity: 0, y: 8 },
            { opacity: 1, y: 0, ease: 'power2.out', duration: 0.3 }, 0.42);
        }
      }

      /* -- 7c. Reading highlight ------------------------------------------
         One paragraph on the whole site starts dim and takes its colour a
         word at a time as it crosses the middle of the viewport. Applied to
         every paragraph this becomes an obstacle; applied once it sets the
         pace on the sentence that most needs reading. */
      const highlight = document.querySelector<HTMLElement>('[data-highlight]');
      if (highlight) {
        const hs = new SplitText(highlight, { type: 'words', wordsClass: 'hl-word' });
        gsap.set(hs.words, { opacity: 0.3 });
        gsap.to(hs.words, {
          opacity: 1, ease: 'none', duration: 1, stagger: 1,
          scrollTrigger: {
            trigger: highlight, start: 'top 76%', end: 'bottom 55%',
            scrub: 0.4, invalidateOnRefresh: true,
          },
        });
      }

      /* -- 7d. The pinned platform section --------------------------------
         The stage pins; the wheel then drives one progress value that feeds
         the WebGL morph, the panel index, the rail and the ground colour.
         scrub: 1 adds the lag that makes the animation ease toward the scroll
         position instead of snapping to it. */
      const platform = document.querySelector<HTMLElement>('[data-platform]');
      const stage = platform?.querySelector<HTMLElement>('[data-platform-stage]');
      if (platform && stage && wide) {
        platform.classList.add('is-pinned');

        const panels = gsap.utils.toArray<HTMLElement>('[data-platform-panel]', platform);
        const nodes = gsap.utils.toArray<SVGCircleElement>('[data-rail-node]', platform);
        const railPath = platform.querySelector<SVGLineElement>('[data-rail-path]');
        const panelBox = platform.querySelector<HTMLElement>('[data-platform-panels]');
        const caption = platform.querySelector<HTMLElement>('[data-platform-caption]');
        const grid = platform.querySelector<HTMLElement>('[data-platform-grid]');

        // The rail draws itself: the whole stroke is one dash, offset out of
        // view and pulled back in as the section advances.
        const railLen = 284;
        if (railPath) {
          railPath.style.strokeDasharray = String(railLen);
          railPath.style.strokeDashoffset = String(railLen);
        }
        gsap.set(nodes, { transformOrigin: '50% 50%', scale: 0.55, opacity: 0.35 });

        // Panel copy changes just after each morph begins, so the reader has
        // the new heading in front of them while the structure assembles.
        const CUTS = [0.38, 0.75];
        const setPanel = (i: number) => {
          panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
          nodes.forEach((nd, k) => gsap.to(nd, {
            scale: k <= i ? 1 : 0.55,
            opacity: k <= i ? 1 : 0.35,
            duration: 0.35, ease: 'power2.out',
          }));
        };
        let active = -1;

        // Entering the section, the warm ground of the page above darkens into
        // deep blue. The panel copy is held back until that has finished, so
        // light text never sits on the intermediate colour.
        const mixer = gsap.utils.interpolate('#ffffff', '#09143a');
        gsap.set(panelBox, { opacity: 0 });
        gsap.set([caption, grid], { opacity: 0 });

        ScrollTrigger.create({
          trigger: platform,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 3.6,
          pin: stage,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate(self) {
            const p = self.progress;
            window.__molecule?.set(p);

            // The ground darkens first and the copy follows it, with no
            // overlap: white text at 75% over a mid slate is the one place a
            // colour transition like this breaks contrast, and this keeps the
            // two out of each other's way entirely.
            const ground = Math.min(1, p / 0.055);
            const copy = Math.min(1, Math.max(0, (p - 0.055) / 0.05));
            stage.style.backgroundColor = mixer(ground);
            gsap.set(panelBox, { opacity: copy });
            gsap.set(caption, { opacity: copy * 0.9 });
            gsap.set(grid, { opacity: ground * 0.16 });
            if (railPath) railPath.style.strokeDashoffset = String(railLen * (1 - p));

            const i = p < CUTS[0] ? 0 : p < CUTS[1] ? 1 : 2;
            if (i !== active) { active = i; setPanel(i); }
          },
        });
        setPanel(0);
      }

      /* -- 7e. Horizontal photo strip -------------------------------------
         Short on purpose, and never the only route to the content: the same
         four photographs are stacked in the fallback for narrow viewports and
         for no-JS. */
      const strip = document.querySelector<HTMLElement>('[data-strip]');
      const track = strip?.querySelector<HTMLElement>('[data-strip-track]');
      if (strip && track && wide) {
        strip.classList.add('is-pinned');
        const counter = strip.querySelector<HTMLElement>('[data-strip-counter]');
        const cards = gsap.utils.toArray<HTMLElement>('[data-strip-card]', strip);
        const imgs = gsap.utils.toArray<HTMLElement>('[data-strip-img]', strip);
        const total = String(cards.length).padStart(2, '0');
        const travel = () => Math.max(0, track.scrollWidth - window.innerWidth + 64);

        const stripTl = gsap.timeline({
          scrollTrigger: {
            trigger: strip,
            start: 'top top',
            end: () => '+=' + travel(),
            pin: '.strip-stage',
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate(self) {
              if (!counter) return;
              const i = Math.min(cards.length - 1, Math.floor(self.progress * cards.length + 0.15));
              counter.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
            },
          },
        });
        stripTl.to(track, { x: () => -travel(), ease: 'none' }, 0);
        // Each picture drifts against its own frame, so there is motion inside
        // the cards as well as across the row.
        stripTl.fromTo(imgs, { xPercent: 5 }, { xPercent: -5, ease: 'none' }, 0);
      }

      ScrollTrigger.refresh();
    })();
  }

  /* ---- Failsafe ---------------------------------------------------------
     Nothing may be lost to a decorative animation. */
  window.setTimeout(() => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-item]')) {
      if (getComputedStyle(el).opacity === '0' && el.getBoundingClientRect().top < window.innerHeight) {
        el.style.opacity = '1';
        el.style.transform = 'none';
      }
    }
    for (const frame of document.querySelectorAll<HTMLElement>('[data-reveal-img]')) {
      if (frame.getBoundingClientRect().top < window.innerHeight) frame.classList.add('is-revealed');
    }
    const h = document.querySelector<HTMLElement>('[data-hero-title]');
    if (h && getComputedStyle(h).opacity === '0') h.style.opacity = '1';
    // The wordmark is hidden by CSS and handed over by the scrubbed timeline.
    // If that timeline never got built, the header must not stay blank.
    const dock = document.querySelector<HTMLElement>('[data-dock-title]');
    if (dock && !dock.style.opacity && getComputedStyle(dock).opacity === '0') {
      dock.style.opacity = '1';
    }
  }, 2500);
</script>
