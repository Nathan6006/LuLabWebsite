---
/**
 * Site-wide motion layer, all GSAP, no framework.
 *
 * The home page is the flashy one — a masthead that assembles, a pinned photo
 * sequence you scrub through, counters that run up. Every other page keeps the
 * quiet pair: a short rise per block, one mask wipe per image.
 *
 * Bundle shape matters here. The simple reveals only ever needed "is this on
 * screen yet", which IntersectionObserver answers natively, so they no longer
 * pull ScrollTrigger in. ScrollTrigger and SplitText are dynamically imported
 * and only ever fetched by the home page, which is the only page that pins or
 * splits anything. That keeps ~85KB off every other route.
 *
 * Two rules enforced everywhere:
 *  - Nothing above the fold is hidden by CSS. Pre-hiding the largest text block
 *    until this script runs pushed LCP from 1.7s to 3.5s.
 *  - Anything already on screen animates immediately rather than waiting for a
 *    scroll event that may never come.
 */
---

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fold = window.innerHeight * 0.9;
  const desktop = window.matchMedia('(min-width: 768px)').matches;

  /** Run `fn` once, now if the element is already on screen, else on approach. */
  function whenSeen(el: Element, fn: () => void, margin = '0px 0px -10% 0px') {
    if (el.getBoundingClientRect().top < fold) { fn(); return; }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.disconnect();
        fn();
      }
    }, { rootMargin: margin });
    io.observe(el);
  }

  /* ---- 1. Block reveals -------------------------------------------------- */
  if (!reduced) {
    for (const block of gsap.utils.toArray<HTMLElement>('[data-reveal]')) {
      if (block.getBoundingClientRect().top < fold) continue;
      const items = block.querySelectorAll<HTMLElement>('[data-reveal-item]');
      const subjects = items.length ? Array.from(items) : [block];
      whenSeen(block, () => {
        gsap.from(subjects, {
          y: 22, opacity: 0, duration: 0.62, ease: 'power3.out',
          stagger: items.length ? 0.055 : 0, force3D: true,
          onComplete() { for (const s of subjects) s.style.willChange = 'auto'; },
        });
      });
    }
  }

  /* ---- 2. Image reveals -------------------------------------------------- */
  for (const frame of gsap.utils.toArray<HTMLElement>('[data-reveal-img]')) {
    const img = frame.querySelector('img');
    if (!img) continue;
    if (reduced) { frame.classList.add('is-revealed'); continue; }
    const play = () => {
      const tl = gsap.timeline({ onComplete: () => { img.style.willChange = 'auto'; } });
      tl.fromTo(frame, { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: 0.92, ease: 'power3.inOut' }, 0);
      tl.fromTo(img, { scale: 1.08 }, { scale: 1, duration: 1.15, ease: 'power3.out', force3D: true }, 0);
      frame.classList.add('is-revealed');
    };
    if (frame.hasAttribute('data-reveal-img-immediate')) play();
    else whenSeen(frame, play);
  }

  /* ---- 3. Counters ------------------------------------------------------- */
  for (const el of gsap.utils.toArray<HTMLElement>('[data-count]')) {
    const target = Number(el.dataset.count);
    if (!Number.isFinite(target)) continue;
    if (reduced) { el.textContent = String(target); continue; }
    whenSeen(el, () => {
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target, duration: 1.5, ease: 'power2.out',
        onUpdate() { el.textContent = String(Math.round(obj.v)); },
      });
    });
  }

  /* ---- 4. Header over the hero ------------------------------------------ */
  const header = document.querySelector<HTMLElement>('[data-header][data-over-hero]');
  if (header) {
    const first = document.querySelector<HTMLElement>('main > section');
    const setSolid = () => {
      const past = first
        ? first.getBoundingClientRect().bottom <= header.offsetHeight + 8
        : window.scrollY > 40;
      header.classList.toggle('is-solid', past);
    };
    setSolid();
    window.addEventListener('scroll', setSolid, { passive: true });
    window.addEventListener('resize', setSolid);
  }

  /* ---- 4b. Hero depth planes ---------------------------------------------
     Planes track the cursor at their own rates so the hero sits in space.
     Transform only, rAF-throttled, and off entirely for reduced motion or a
     coarse pointer — a phone has no cursor to follow. */
  const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
  if (scene && !reduced && window.matchMedia('(pointer: fine)').matches) {
    const planes = gsap.utils.toArray<HTMLElement>('[data-depth]', scene);
    const setters = planes.map((el) => ({
      x: gsap.quickTo(el, 'x', { duration: 0.9, ease: 'power3.out' }),
      y: gsap.quickTo(el, 'y', { duration: 0.9, ease: 'power3.out' }),
      d: Number(el.dataset.depth) || 0,
    }));
    scene.addEventListener('pointermove', (e) => {
      const r = scene.getBoundingClientRect();
      const dx = e.clientX - r.left - r.width / 2;
      const dy = e.clientY - r.top - r.height / 2;
      for (const s of setters) { s.x(-dx * s.d); s.y(-dy * s.d); }
    }, { passive: true });
    scene.addEventListener('pointerleave', () => {
      for (const s of setters) { s.x(0); s.y(0); }
    }, { passive: true });
  }

  /* ---- 4c. Magnetic buttons ----------------------------------------------- */
  if (!reduced && window.matchMedia('(pointer: fine)').matches) {
    for (const btn of gsap.utils.toArray<HTMLElement>('[data-magnet]')) {
      const toX = gsap.quickTo(btn, 'x', { duration: 0.5, ease: 'power3.out' });
      const toY = gsap.quickTo(btn, 'y', { duration: 0.5, ease: 'power3.out' });
      btn.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        toX((e.clientX - r.left - r.width / 2) * 0.32);
        toY((e.clientY - r.top - r.height / 2) * 0.42);
      }, { passive: true });
      btn.addEventListener('pointerleave', () => { toX(0); toY(0); }, { passive: true });
    }
  }

  /* ---- 4d. Card tilt + spotlight ------------------------------------------
     Cards lean toward the cursor and carry a soft highlight under it. Vanilla
     rather than a React island: it is two transforms and a custom property, and
     the whole point of this file is that nothing here needs a framework. */
  if (!reduced && window.matchMedia('(pointer: fine)').matches) {
    for (const card of gsap.utils.toArray<HTMLElement>('[data-tilt]')) {
      const rx = gsap.quickTo(card, 'rotateX', { duration: 0.5, ease: 'power3.out' });
      const ry = gsap.quickTo(card, 'rotateY', { duration: 0.5, ease: 'power3.out' });
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        ry((px - 0.5) * 7);
        rx((0.5 - py) * 5);
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
      }, { passive: true });
      card.addEventListener('pointerleave', () => { rx(0); ry(0); }, { passive: true });
    }
  }

  /* ---- 5. Hero plate drift ----------------------------------------------- */
  const plate = document.querySelector<HTMLElement>('.hero-plate');
  if (plate && !reduced) {
    gsap.fromTo(plate, { scale: 1.06 }, { scale: 1.14, duration: 26, ease: 'none' });
  }

  /* ---- 6. Home-only: masthead + pinned sequence -------------------------
     Both plugins are fetched here and nowhere else. */
  const hero = document.querySelector<HTMLElement>('[data-hero-title]');
  const seq = document.querySelector<HTMLElement>('[data-lab-seq]');

  if (!reduced && (hero || (seq && desktop))) {
    (async () => {
      if (hero) {
        const { SplitText } = await import('gsap/SplitText');
        gsap.registerPlugin(SplitText);
        const runHero = () => {
          const split = new SplitText(hero, { type: 'lines', linesClass: 'hero-line' });
          for (const line of split.lines) {
            const mask = document.createElement('span');
            mask.className = 'hero-line-mask';
            line.parentNode?.insertBefore(mask, line);
            mask.appendChild(line);
          }
          gsap.set(hero, { opacity: 1 });
          gsap.from(split.lines, { yPercent: 118, duration: 1.05, ease: 'expo.out', stagger: 0.085 });
          gsap.from('[data-hero-follow]', {
            y: 18, opacity: 0, duration: 0.8, ease: 'power3.out', stagger: 0.09, delay: 0.42,
          });
        };
        if (document.fonts && document.fonts.status !== 'loaded') document.fonts.ready.then(runHero);
        else runHero();
      }

      /* Nanoparticle scrollytelling: the render turns in 3D while the three
         stages take turns beside it. Rotation is scrubbed CSS 3D, not WebGL —
         one image and a perspective is all it needs, and it stays sharp. */
      const nano = document.querySelector<HTMLElement>('[data-nano]');
      if (nano && desktop) {
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);

        const orbit = nano.querySelector<HTMLElement>('[data-nano-orbit]');
        const copies = gsap.utils.toArray<HTMLElement>('[data-nano-copy]', nano);
        const nticks = gsap.utils.toArray<HTMLElement>('[data-nano-tick]', nano);
        const glow = nano.querySelector<HTMLElement>('[data-nano-glow]');
        const m = copies.length;

        if (m > 0 && orbit) {
          nano.classList.add('is-pinned');

          let nActive = -1;
          const setNano = (i: number) => {
            if (i === nActive) return;
            nActive = i;
            copies.forEach((c, k) => c.classList.toggle('is-active', k === i));
            nticks.forEach((t, k) => gsap.to(t, { scaleX: k <= i ? 1 : 0, duration: 0.4, ease: 'power2.out' }));
          };
          setNano(0);

          const nanoTl = gsap.timeline({
            scrollTrigger: {
              trigger: nano,
              start: 'top top',
              end: () => '+=' + window.innerHeight * m,
              pin: '.nano-stage',
              scrub: 0.7,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              onUpdate(self) { setNano(Math.min(m - 1, Math.floor(self.progress * m))); },
            },
          });

          // A single continuous turn across the whole pin, so the particle is
          // always moving rather than snapping between stages.
          nanoTl.fromTo(orbit,
            { rotateY: -26, rotateX: 9, scale: 0.9 },
            { rotateY: 26, rotateX: -6, scale: 1.04, ease: 'none' }, 0);
          if (glow) nanoTl.fromTo(glow, { opacity: 0.5 }, { opacity: 1, ease: 'none' }, 0);
        }
      }

      if (seq && desktop) {
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);

        const frames = gsap.utils.toArray<HTMLElement>('[data-seq-frame]', seq);
        const captions = gsap.utils.toArray<HTMLElement>('[data-seq-caption]', seq);
        const ticks = gsap.utils.toArray<HTMLElement>('[data-seq-tick]', seq);
        const counter = seq.querySelector<HTMLElement>('[data-seq-counter]');
        const n = frames.length;
        if (n < 2) return;

        seq.classList.add('is-pinned');
        gsap.set(frames, { autoAlpha: 0, scale: 1.12 });
        gsap.set(frames[0], { autoAlpha: 1, scale: 1 });
        gsap.set(ticks, { scaleX: 0 });

        // Captions, ticks and the counter run off one active index rather than
        // overlapping tweens. Under a scrub two crossfading tweens can both be
        // partly visible at the same scroll position, which put two captions on
        // screen at once; an index cannot do that.
        let active = -1;
        const setActive = (i: number) => {
          if (i === active) return;
          active = i;
          captions.forEach((c, k) => c.classList.toggle('is-active', k === i));
          ticks.forEach((t, k) => gsap.to(t, { scaleX: k <= i ? 1 : 0, duration: 0.35, ease: 'power2.out' }));
          if (counter) counter.textContent = `${String(i + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
        };
        setActive(0);

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: seq,
            start: 'top top',
            end: () => '+=' + window.innerHeight * (n - 0.35),
            pin: '.lab-seq-stage',
            scrub: 0.6,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate(self) { setActive(Math.min(n - 1, Math.floor(self.progress * n))); },
          },
        });

        for (let i = 1; i < n; i++) {
          const at = i - 1;
          tl.to(frames[i - 1], { autoAlpha: 0, scale: 1.06, ease: 'power1.inOut' }, at + 0.55)
            .to(frames[i], { autoAlpha: 1, scale: 1, ease: 'power1.inOut' }, at + 0.55);
        }
        tl.to({}, { duration: 0.35 });
      }
    })();
  }

  /* ---- Failsafe ---------------------------------------------------------
     Nothing may be lost to a decorative animation. */
  window.setTimeout(() => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-item]')) {
      if (getComputedStyle(el).opacity === '0' && el.getBoundingClientRect().top < window.innerHeight) {
        el.style.opacity = '1';
        el.style.transform = 'none';
      }
    }
    for (const frame of document.querySelectorAll<HTMLElement>('[data-reveal-img]')) {
      if (frame.getBoundingClientRect().top < window.innerHeight) frame.classList.add('is-revealed');
    }
    const h = document.querySelector<HTMLElement>('[data-hero-title]');
    if (h && getComputedStyle(h).opacity === '0') h.style.opacity = '1';
  }, 2500);
</script>
