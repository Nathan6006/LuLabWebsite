---
import { NAV } from '../lib/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-[76rem] flex-wrap items-center gap-x-8 gap-y-3 px-5 py-4 sm:px-8">
    <a href="/" class="group mr-auto flex flex-col leading-tight">
      <span class="font-serif text-[1.06rem] font-semibold tracking-[-0.01em] text-cwru-blue sm:text-[1.18rem]">
        Center for Biomolecular Engineering
      </span>
      <span class="text-[0.72rem] font-medium uppercase tracking-[0.11em] text-ink-mute">
        Case Western Reserve University
      </span>
    </a>

    <nav aria-label="Main" class="w-full min-w-0 max-w-full overflow-x-auto sm:w-auto sm:overflow-visible">
      <ul class="flex items-center gap-x-1 whitespace-nowrap">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'relative block rounded-sm px-2.5 py-2 text-[0.9rem] font-medium transition-colors',
                isCurrent(item.href)
                  ? 'text-cwru-blue after:absolute after:inset-x-2.5 after:bottom-0.5 after:h-[2px] after:bg-copper after:content-[""]'
                  : 'text-ink-soft hover:text-cwru-blue',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
